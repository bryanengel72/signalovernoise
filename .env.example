# Copy to .env.local and fill in. Anything prefixed VITE_ is baked into the
# public browser bundle — never put a secret behind that prefix.

# --- Client (public) ---
# Cloudflare Turnstile site key: dash.cloudflare.com -> Turnstile -> your widget.
# For local development you can use Cloudflare's "always passes" test key:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# --- Server only (Vercel project env vars, used by api/contact.ts) ---
# Turnstile secret key, from the same widget page.
# Matching local test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase service-role key (Project Settings -> API Keys).
# Bypasses RLS. Server-side only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
